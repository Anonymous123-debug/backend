# Database Configuration
DATABASE_URL=sqlite:///./calendar_sync.db
# For PostgreSQL: postgresql://user:password@localhost:5432/calendar_sync

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Webhook Configuration
# For local development, use ngrok: https://ngrok.com/
# Run: ngrok http 8000, then paste the HTTPS URL here
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.dev

# Application Security
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
DEBUG=True

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
